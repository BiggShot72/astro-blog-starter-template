---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Mike's Tire Service | Clarksville, TN" description="Reliable, affordable new and used tires in Clarksville, TN." />
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Section -->
			<section class="hero">
				<h1>Mike's Tire Service</h1>
				<p class="tagline">Reliable, Affordable New & Used Tires in Clarksville, TN</p>
				<div class="cta-buttons">
					<a href="tel:9318962440" class="btn-primary">📞 Call Now: (931) 896-2440</a>
					<a href="geo:0,0?q=Mikes+Tire+Service+1114+College+St+Clarksville+TN+37040" class="btn-secondary">📍 Open Google Maps</a>
				</div>
			</section>

			<!-- Our Tire Services -->
			<section class="services" id="services">
				<h2>Our Tire Services</h2>
				<ul>
					<li><strong>New & Used Tires</strong> – Top brands at budget-friendly prices.</li>
					<li><strong>Tire Repair & Patching</strong> – Quick fixes to get you back on the road safely.</li>
					<li><strong>Mounting & Balancing</strong> – Precision installation for a smooth ride.</li>
					<li><strong>Tire Rotation</strong> – Extend the life of your tread.</li>
				</ul>
			</section>

			<!-- Interactive Tire Size Tool -->
			<section class="tire-tool" id="tire-tool">
				<h2>Tire Size Lookup & Guide</h2>
				<div class="tool-container">
					<p class="tool-intro">Unsure what the numbers on your tire sidewall mean? Enter them below to see exactly what you are running!</p>
					
					<div class="calculator-box">
						<div class="input-row">
							<div class="input-group">
								<label for="width">Width (mm)</label>
								<input type="number" id="width" value="215" placeholder="e.g. 215" />
							</div>
							<div class="input-sep">/</div>
							<div class="input-group">
								<label for="aspect">Aspect Ratio</label>
								<input type="number" id="aspect" value="65" placeholder="e.g. 65" />
							</div>
							<div class="input-sep">R</div>
							<div class="input-group">
								<label for="wheel">Wheel Size (in)</label>
								<input type="number" id="wheel" value="16" placeholder="e.g. 16" />
							</div>
						</div>
						
						<button id="calc-btn" class="btn-primary">📐 Calculate Overall Specs</button>
					</div>

					<!-- Real-time Dynamic Outputs -->
					<div class="results-box" id="results-box">
						<div class="result-card">
							<span class="result-label">Total Tire Height:</span>
							<strong id="out-height">27.0 inches</strong>
						</div>
						<div class="result-card">
							<span class="result-label">Sidewall Height:</span>
							<strong id="out-sidewall">5.5 inches</strong>
						</div>
					</div>
				</div>
			</section>

			<!-- Hours & Location -->
			<section class="info" id="location">
				<h2>Shop Hours & Location</h2>
				<div class="info-grid">
					<div class="hours">
						<h3>🕒 Hours of Operation</h3>
						<p>Monday - Friday: 8:00 AM - 6:00 PM</p>
						<p>Saturday: 8:00 AM - 3:00 PM</p>
						<p>Sunday: Closed</p>
					</div>
					<div class="address">
						<h3>📍 Visit Us</h3>
						<p><strong>Mike's Tire Service</strong></p>
						<p>1114 College St.</p>
						<p>Clarksville, TN 37040</p>
						<p><em>Stop by or call ahead for fast service!</em></p>
					</div>
				</div>
			</section>

			<!-- Financing Section -->
			<section class="financing" id="financing">
				<h2>Easy Tire Financing</h2>
				<div class="financing-card">
					<!-- Styled FinTech Logo Treatment -->
					<div class="kafene-brand-logo">
						<span class="logo-power">POWERED BY</span>
						<span class="logo-main">kafene</span>
					</div>
					
					<h3>💳 Buy Now, Pay Later</h3>
					<p class="financing-subtitle">Get the new or used tires you need today with flexible, lease-to-own options.</p>
					
					<!-- Trust Badges Grid Layout -->
					<div class="badge-grid">
						<div class="trust-badge">
							<div class="badge-icon">⏱️</div>
							<div class="badge-title">60-Second Apply</div>
							<div class="badge-desc">Instant decisions right from your phone.</div>
						</div>
						<div class="trust-badge">
							<div class="badge-icon">❌</div>
							<div class="badge-title">No Credit Needed</div>
							<div class="badge-desc">Approvals built on more than just scores.</div>
						</div>
						<div class="trust-badge">
							<div class="badge-icon">💰</div>
							<div class="badge-title">Up to $5,000</div>
							<div class="badge-desc">High approval limits to cover full sets & mounts.</div>
						</div>
					</div>

					<div class="financing-cta">
						<a href="https://gokafene.com" target="_blank" rel="noopener noreferrer" class="btn-primary">👉 Apply Here</a>
					</div>
					<p class="disclaimer">Must be 18+ with a valid ID and active checking account to apply.</p>
				</div>
			</section>
		</main>
		<Footer />

		<!-- Client-Side Engine Initialization -->
		<script is:inline>
			function calculateTireSpecs() {
				const width = parseFloat(document.getElementById('width').value);
				const aspect = parseFloat(document.getElementById('aspect').value);
				const wheel = parseFloat(document.getElementById('wheel').value);

				if (!width || !aspect || !wheel) return;

				// Calculation formula for tire dimensions
				const sidewallMm = width * (aspect / 100);
				const sidewallInches = sidewallMm / 25.4;
				const totalHeightInches = (sidewallInches * 2) + wheel;

				document.getElementById('out-sidewall').innerText = sidewallInches.toFixed(1) + ' inches';
				document.getElementById('out-height').innerText = totalHeightInches.toFixed(1) + ' inches';
			}

			// DOM Event Hookup after load
			document.addEventListener('DOMContentLoaded', () => {
				document.getElementById('calc-btn').addEventListener('click', calculateTireSpecs);
			});
		</script>
	</body>
</html>
<style is:global>
	/* This absolute master override cracks open the template layout container constraints on phones */
	@media (max-width: 600px) {
		html, body {
			margin: 0 !important;
			padding: 0 !important;
			width: 100% !important;
			max-width: 100% !important;
			overflow-x: hidden !important;
		}
		
		/* Forces the hidden container file to expand full width */
		body > div, 
		main, 
		header, 
		nav,
		footer {
			max-width: 100% !important;
			width: 100% !important;
			padding-left: 1rem !important;
			padding-right: 1rem !important;
			box-sizing: border-box !important;
			margin: 0 auto !important;
		}

		/* Centers the text elements and fixes font sizing layout glitches */
		nav {
			display: flex !important;
			flex-direction: column !important;
			align-items: center !important;
			justify-content: center !important;
			text-align: center !important;
		}
		
		nav h2, .site-title {
			font-size: 1.75rem !important;
			width: 100% !important;
			text-align: center !important;
			margin-bottom: 0.5rem !important;
		}

		.internal-links {
			display: flex !important;
			justify-content: center !important;
			gap: 2.5rem !important;
			width: 100% !important;
		}

		nav a {
			font-size: 1.2rem !important;
			padding: 0.5rem !important;
		}
		
		footer, footer p, .copyright {
			text-align: center !important;
			font-size: 1.1rem !important;
			width: 100% !important;
		}
	}
</style>

<style>
	main {
		margin: auto;
		padding: 2rem;
		max-width: 960px;
		font-family: sans-serif;
	}
	.hero {
		text-align: center;
		padding: 3rem 1rem;
		background: #111;
		color: #fff;
		border-radius: 8px;
		margin-bottom: 2rem;
	}
	.hero h1 { font-size: 2.5rem; margin-bottom: 0.5rem; color: #fff; }
	.tagline { font-size: 1.2rem; color: #ccc; }
	.cta-buttons { margin-top: 1.5rem; display: flex; gap: 1rem; justify-content: center; }
	.btn-primary { background: #ff4500; color: white; padding: 0.8rem 1.5rem; border-radius: 5px; text-decoration: none; font-weight: bold; display: inline-block; }
	.btn-secondary { background: #333; color: white; padding: 0.8rem 1.5rem; border-radius: 5px; text-decoration: none; display: inline-block; }
	.services, .info, .financing, .tire-tool { margin-top: 3rem; }
	h2 { border-bottom: 2px solid #ccc; padding-bottom: 0.5rem; margin-bottom: 1rem; }
	ul { list-style-type: none; padding: 0; }
	li { padding: 0.5rem 0; font-size: 1.1rem; }
	.info-grid { display: flex; gap: 2rem; justify-content: space-between; flex-wrap: wrap; }
	
	/* Tire Lookup Block Layout */
	.tool-container {
		background: #111111;
		color: #ffffff;
		padding: 2.5rem 1.5rem;
		border-radius: 12px;
		text-align: center;
	}
	.tool-intro { color: #cccccc; margin-bottom: 2rem; font-size: 1.05rem; }
	
	.calculator-box {
		max-width: 500px;
		margin: 0 auto;
		background: #222222;
		padding: 1.5rem;
		border-radius: 8px;
		border: 1px solid #333333;
	}
	.input-row {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
	}
	.input-group {
		display: flex;
		flex-direction: column;
		align-items: center;
		flex: 1;
	}
	.input-group label {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05rem;
		color: #aaa;
		margin-bottom: 0.4rem;
	}
	.input-group input {
		width: 100%;
		padding: 0.6rem;
		background: #333;
		border: 1px solid #444;
		color: white;
		border-radius: 4px;
		text-align: center;
		font-size: 1.2rem;
		font-weight: bold;
	}
	.input-sep {
		font-size: 1.5rem;
		font-weight: bold;
		color: #ff4500;
		padding-top: 1.2rem;
	}
	.calculator-box button {
		width: 100%;
		cursor: pointer;
		border: none;
	}

	/* Dynamic Visual Result Cards */
	.results-box {
		display: flex;
		gap: 1rem;
		max-width: 500px;
		margin: 1.5rem auto 0;
	}
	.result-card {
		flex: 1;
		background: #1a1a1a;
		padding: 1rem;
		border-radius: 6px;
		border: 1px solid #ff4500;
	}
	.result-label { display: block; font-size: 0.85rem; color: #aaa; margin-bottom: 0.25rem; }
	.result-card strong { font-size: 1.4rem; color: white; }

	/* Redesigned Financing Styles */
	.financing { text-align: center; margin-bottom: 3rem; }
	.financing-card { 
		background: #ffffff; 
		padding: 3rem 2rem; 
		border-radius: 12px; 
		border: 1px solid #e1e8ed; 
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
	}
	
	/* Custom CSS Logo replicating clean typography */
	.kafene-brand-logo {
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		margin-bottom: 1.5rem;
	}
	.logo-power {
		font-size: 0.65rem;
		letter-spacing: 0.15rem;
		color: #7b7c83;
		font-weight: 700;
		margin-bottom: -0.2rem;
	}
	.logo-main {
		font-size: 2.2rem;
		font-weight: 800;
		color: #060709;
		letter-spacing: -0.05rem;
		font-family: 'Arial Black', sans-serif;
	}
	
	.financing-card h3 { 
		margin-top: 0.5rem; 
		font-size: 1.6rem;
		color: #111; 
	}
	.financing-subtitle { 
		font-size: 1.15rem; 
		color: #555; 
		margin-bottom: 2.5rem; 
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}
	
	/* Layout Grid for the Trust Features */
	.badge-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.5rem;
		margin-bottom: 2.5rem;
	}
	.trust-badge {
		background: #f8f9fa;
		padding: 1.5rem;
		border-radius: 8px;
		border: 1px solid #edf0f2;
		transition: transform 0.2s ease;
	}
	.trust-badge:hover {
		transform: translateY(-2px);
	}
	.badge-icon {
		font-size: 2rem;
		margin-bottom: 0.5rem;
	}
	.badge-title {
		font-weight: bold;
		font-size: 1.1rem;
		color: #111;
		margin-bottom: 0.25rem;
	}
	.badge-desc {
		font-size: 0.9rem;
		color: #666;
		line-height: 1.3;
	}
	
	.financing-cta { 
		display: flex; 
		justify-content: center; 
		margin-bottom: 1rem;
	}
	.disclaimer {
		font-size: 0.8rem;
		color: #888;
		margin-top: 1rem;
	}
</style>

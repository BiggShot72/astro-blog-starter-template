---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="tel:9318962440">📞 Call Shop</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1rem;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1.25rem;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
		color: #111;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 960px;
		margin: 0 auto;
		padding: 1rem 0;
	}
	.internal-links {
		display: flex;
		gap: 1.5rem;
	}
	nav a {
		padding: 0.5rem 0.25rem;
		color: #333;
		border-bottom: 4px solid transparent;
		text-decoration: none;
		font-weight: 500;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: #ff4500;
		font-weight: bold;
	}

	/* Mobile Screen Specific Rules */
	@media (max-width: 600px) {
		nav {
			flex-direction: column;
			gap: 0.75rem;
			text-align: center;
			padding: 1rem 0 0.5rem 0;
		}
		.internal-links {
			justify-content: center;
			width: 100%;
			gap: 2rem;
		}
	}
</style>

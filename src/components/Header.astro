---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/#services">Services</HeaderLink>
			<HeaderLink href="/#location">Hours</HeaderLink>
			<HeaderLink href="/#financing" class="nav-financing">Financing</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1rem;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		width: 100%;
		box-sizing: border-box;
	}
	h2 {
		margin: 0;
		font-size: 1.5rem;
		white-space: nowrap;
	}
	h2 a,
	h2 a.active {
		text-align: center;
		text-decoration: none;
		color: #111;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 960px;
		margin: 0 auto;
		padding: 1rem 0;
	}
	.internal-links {
		display: flex;
		gap: 1.25rem;
		align-items: center;
	}
	nav a {
		padding: 0.5rem 0.25rem;
		color: #333;
		border-bottom: 4px solid transparent;
		text-decoration: none;
		font-weight: 500;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: #ff4500;
		font-weight: bold;
	}
	.nav-financing {
		color: #ff4500 !important;
		font-weight: bold;
	}

	/* Responsive mobile fixes that match your layout overrides */
	@media (max-width: 600px) {
		header {
			padding: 0 0.5rem;
		}
		nav {
			flex-direction: column !important;
			gap: 0.75rem;
			padding: 1rem 0;
		}
		h2 {
			font-size: 1.6rem !important;
			text-align: center;
		}
		.internal-links {
			justify-content: center !important;
			gap: 0.75rem !important;
			width: 100% !important;
			flex-wrap: wrap;
		}
		nav a {
			font-size: 1rem !important;
			padding: 0.25rem 0.4rem !important;
		}
	}
</style>

---
const today = new Date();
---

<footer>
	<!-- 1. The copyright stays on top in the code so the template layout doesn't break the image -->
	<p class="copyright">&copy; {today.getFullYear()} Mike's Tire Service. All rights reserved.</p>

	<!-- 2. The exact official BBB snippet stays at the bottom in the code -->
	<div class="bbb-seal-wrapper">
		<a href="https://bbb.org" target="_blank" rel="nofollow">
			<img src="https://bbb.org" style="border: 0;" alt="Mike's Tire Service BBB Business Review" />
		</a>
	</div>

	<div class="social-links">
		<!-- Social links placeholder -->
	</div>
</footer>

<style>
	footer {
		padding: 3rem 1rem;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
	}
	
	/* THIS CODES FLIPS THE POSITION VISUALLY: Forces the seal to display on top of the copyright row */
	.bbb-seal-wrapper {
		order: 1 !important; 
		margin-bottom: 1.5rem !important;
		display: flex !important;
		justify-content: center !important;
		align-items: center !important;
		width: 100% !important;
	}

	.bbb-seal-wrapper img {
		width: 260px !important; /* Kept it at that nice upscaled size you wanted */
		max-width: 90% !important;
		height: auto !important;
		display: block !important;
	}

	/* Forces the copyright row to display at the absolute bottom */
	.copyright {
		order: 2 !important; 
		margin: 0 !important;
		text-align: center !important;
		width: 100% !important;
		display: block !important;
		font-size: 1rem !important;
	}
</style>

---
const today = new Date();
---

<footer>
	<!-- Official Better Business Bureau Dynamic Seal Banner (Upscaled Size) -->
	<div class="bbb-seal-container">
		<a href="https://bbb.org" target="_blank" rel="nofollow">
			<img src="https://bbb.org" style="border: 0;" alt="Mike's Tire Service BBB Business Review" />
		</a>
	</div>

	<p class="copyright">&copy; {today.getFullYear()} Mike's Tire Service. All rights reserved.</p>

	<div class="social-links">
		<!-- Social icons can be dropped here later if needed -->
	</div>
</footer>

<style>
	footer {
		padding: 3rem 1rem;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
	}
	.bbb-seal-container {
		margin-bottom: 1.5rem;
		display: flex;
		justify-content: center;
		align-items: center;
		width: 100%;
	}
	.bbb-seal-container img {
		/* Scale modifications to increase size safely across layouts */
		width: 260px !important; /* Bumped up from the stock 200px footprint */
		max-width: 90% !important;
		height: auto !important;
		display: block;
	}
	.copyright {
		margin: 0;
		text-align: center;
		width: 100%;
		display: block;
		font-size: 1rem;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1rem;
		margin-top: 1rem;
	}
</style>
